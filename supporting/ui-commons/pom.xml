<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- What the UIs had each copied for themselves: paging a listing, who is signed in (the user
         widget of the consoles and the front office, and the name a control-plane action is
         recorded under), the markup of a table of links, and the base of a catalogue CRUD.

         A library, not an application: no image. Spring Boot's parent only for its dependency
         management — it is not repackaged. Everything it compiles against is `provided`: each
         service already brings Mateu, Jackson and (when it pages in a database) Spring Data, and
         this jar must not pick their versions for them. Installed before the services that use
         it — see deploy/build-images.sh. -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.4</version>
        <relativePath/>
    </parent>

    <groupId>io.mateu.ecdemo1</groupId>
    <artifactId>ui-commons</artifactId>
    <version>0.1.0</version>
    <name>ec-demo1 ui-commons</name>
    <description>What the Mateu UIs of the demo share: paging, the signed-in user, link tables, a catalogue CRUD base</description>

    <properties>
        <java.version>21</java.version>
        <mateu.version>3.0-alpha.421</mateu.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.mateu</groupId>
            <artifactId>core</artifactId>
            <version>${mateu.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>io.mateu</groupId>
            <artifactId>uidl</artifactId>
            <version>${mateu.version}</version>
            <scope>provided</scope>
        </dependency>
        <!-- Only DbPaging touches it, and only a service with a database calls DbPaging. -->
        <dependency>
            <groupId>org.springframework.data</groupId>
            <artifactId>spring-data-commons</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>2.22.1</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
