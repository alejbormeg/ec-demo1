<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.4</version>
        <relativePath/>
    </parent>

    <groupId>io.mateu.ecdemo1</groupId>
    <artifactId>content</artifactId>
    <version>0.1.0</version>
    <name>ec-demo1 content</name>
    <description>Content, labels and content types: a Mateu CRUD the shell hosts at /_content</description>

    <properties>
        <java.version>21</java.version>
        <!-- Pinned rather than floating, like the shell's. -->
        <mateu.version>3.0-alpha.420</mateu.version>
        <!-- Only for `shared`, the engine's DTO jar: this service uses its AggregateRoot base
             class. It tracks the engine image tag in deploy/values/eventconductor.yaml. -->
        <eventconductor.version>2.23.1</eventconductor.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- No Kafka binder, deliberately. The version this was ported from declared
             spring-cloud-stream and three bindings — consumeOutbox, consumeUpstream,
             consumeWorkerEvent — and implemented none of them: there is no such bean anywhere in
             this service. Worse, the groups it named were the engine's own (orchestrator-outbox,
             orchestrator-upstream, worker-group), so deploying it beside a real engine would have
             taken partitions away from the orchestrator and the test worker and dropped whatever
             it was handed. Nothing here produces or consumes an event. -->

        <dependency>
            <groupId>io.mateu.workflow</groupId>
            <artifactId>shared</artifactId>
            <version>${eventconductor.version}</version>
        </dependency>

        <dependency>
            <groupId>io.mateu</groupId>
            <artifactId>mvc-core</artifactId>
            <version>${mateu.version}</version>
        </dependency>
        <!-- What the UIs share: paging, the signed-in user, link tables, the catalogue CRUD base. -->
        <dependency>
            <groupId>io.mateu.ecdemo1</groupId>
            <artifactId>ui-commons</artifactId>
            <version>0.1.0</version>
        </dependency>
        <dependency>
            <groupId>io.mateu</groupId>
            <artifactId>vaadin-lit</artifactId>
            <version>${mateu.version}</version>
        </dependency>
        <dependency>
            <groupId>io.mateu</groupId>
            <artifactId>annotation-processor-mvc</artifactId>
            <version>${mateu.version}</version>
        </dependency>

        <!-- Health probes and the Prometheus endpoint the pod annotation points Prometheus at.
             Without the registry, /actuator/prometheus does not exist even with actuator on the
             classpath, and the scrape silently returns 404 forever. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </path>
                        <path>
                            <groupId>io.mateu</groupId>
                            <artifactId>annotation-processor-mvc</artifactId>
                            <version>${mateu.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
