<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Boot 4.1.1 for Spring AI 2.0.1, which is built against Spring Framework 7.0.9 — the
         version 4.1.1 manages, and the reason for 4.1.1 rather than the 4.0.4 the control plane
         runs. The move off Boot 3.4 was not a tidy-up: 2.0 is the first release whose OpenAI
         client carries a tool call's unknown fields back into the next request, which is what a
         Gemini-backed OpenAI-compatible gateway requires and what 1.x cannot do at all. -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>io.mateu.ecdemo1</groupId>
    <artifactId>ia-agent</artifactId>
    <version>0.1.0</version>
    <name>ec-demo1 ia-agent</name>
    <description>The console's chat agent: an LLM that answers by calling the MCP tools the orchestrator, the forms engine and the booking service expose</description>

    <properties>
        <java.version>21</java.version>
        <spring-ai.version>2.0.1</spring-ai.version>
        <!-- Ahead of what Boot 3.4.1 manages, which does not run on a JDK 25 javac and fails the
             build with "TypeTag :: UNKNOWN" rather than anything that names Lombok. -->
        <lombok.version>1.18.44</lombok.version>
    </properties>

    <dependencies>
        <dependency><groupId>com.h2database</groupId><artifactId>h2</artifactId><scope>test</scope></dependency>
        <!-- Workflow profile only: independent durable worker; chat does not open a database. -->
        <dependency><groupId>org.apache.kafka</groupId><artifactId>kafka-clients</artifactId></dependency>
        <dependency><groupId>org.postgresql</groupId><artifactId>postgresql</artifactId><scope>runtime</scope></dependency>
        <dependency><groupId>org.flywaydb</groupId><artifactId>flyway-core</artifactId></dependency>
        <dependency><groupId>org.flywaydb</groupId><artifactId>flyway-database-postgresql</artifactId><scope>runtime</scope></dependency>
        <dependency><groupId>com.nimbusds</groupId><artifactId>nimbus-jose-jwt</artifactId><version>10.5</version></dependency>
        <dependency><groupId>com.networknt</groupId><artifactId>json-schema-validator</artifactId><version>3.0.1</version></dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- The chat endpoint streams its answer as SSE, so the reactive stack is not optional. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
        </dependency>

        <!-- MCP client. The auto-configured persistent client is switched off in
             application.yaml: PerRequestMcpClientFactory opens a connection per prompt instead,
             because a persistent SSE client that loses its connection stays broken for good. -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-mcp-client</artifactId>
            <version>${spring-ai.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-anthropic</artifactId>
            <version>${spring-ai.version}</version>
        </dependency>
        <!-- The model artifact, NOT spring-ai-starter-model-openai. The starter adds six
             auto-configurations (chat, embedding, image, moderation, transcription, speech) that
             all build a client at startup from spring.ai.openai.* properties this service does
             not have, so it would be six exclusions in application.yaml to get back to where this
             one line already is. Nothing here is auto-configured: ChatClientRegistry builds a
             model per credential, from the catalogue. -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-openai</artifactId>
            <version>${spring-ai.version}</version>
        </dependency>

        <!-- Per-session conversation history, in memory and nowhere else. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-cache</artifactId>
        </dependency>
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>

        <!-- Health probes and the Prometheus endpoint the pod annotation points Prometheus at.
             Without the registry, /actuator/prometheus does not exist even with actuator on the
             classpath, and the scrape silently returns 404 forever. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <!-- Traces, to the same Tempo the engines export to. Three entries because Boot 4 split
             them: the bridge and the OTLP exporter are the OpenTelemetry libraries; what creates
             the Tracer and the SpanExporter — and binds management.tracing.* and
             management.opentelemetry.tracing.export.otlp.* — is spring-boot-micrometer-tracing-
             opentelemetry. Without it both properties are owned by nothing and every span is built
             and dropped, silently: the way the engine shipped 2.2.1. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-micrometer-tracing-opentelemetry</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing-bridge-otel</artifactId>
        </dependency>
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-exporter-otlp</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- The PII redactor's tests. JUnit only: they are plain unit tests, no context. -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
