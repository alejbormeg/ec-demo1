<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <!-- Boot 4, as it came from Mateu's demo-front-office-evolution; 4.1, as ia-agent: its MCP tools are
         served by Spring AI 2.0.1, whose SSE transport never flushes its first event on 4.0 (the
         client's initialize times out) — unlike the services still on Spring AI 1.0, held back to
         Boot 3.4 by it. -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>
    <groupId>io.mateu.ecdemo1</groupId>
    <artifactId>front-office</artifactId>
    <version>0.1.0</version>
    <name>ec-demo1 front-office</name>
    <description>The hotel's front office — check-in, the in-house guests, check-out and folios — brought from Mateu's demo; the integration writes into it every reservation it writes into the PMS</description>
    <properties>
        <java.version>21</java.version>
        <mateu.version>3.0-alpha.415</mateu.version>
        <lombok.version>1.18.44</lombok.version>
        <spring-ai.version>2.0.1</spring-ai.version>
    </properties>
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- The tests run on H2, as the demo did; the deployment on PostgreSQL. -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>io.mateu</groupId>
            <artifactId>annotation-processor-mvc</artifactId>
            <version>${mateu.version}</version>
        </dependency>
        <dependency>
            <groupId>io.mateu</groupId>
            <artifactId>mvc-core</artifactId>
            <version>${mateu.version}</version>
        </dependency>
        <!-- The Redwood (Visual Builder) renderer, as the demo it came from. -->
        <dependency>
            <groupId>io.mateu</groupId>
            <artifactId>redwood</artifactId>
            <version>${mateu.version}</version>
        </dependency>
        <!-- The user widget, the same as the consoles'. -->
        <dependency>
            <groupId>io.mateu.ecdemo1</groupId>
            <artifactId>ui-commons</artifactId>
            <version>0.1.0</version>
        </dependency>
        <!-- A resource server, as the consoles' shells: the browser logs in with Keycloak from the
             bootstrap page and the UI's calls carry the token. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>
        <!-- MCP server: the desk's use cases as tools for the reception agent (ia-agent). -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-mcp-server-webmvc</artifactId>
            <version>${spring-ai.version}</version>
        </dependency>
        <!-- What the agent does here is audited as every agent action is: an AuditedAction on the
             `audit` topic, relayed from an outbox table. Plain spring-kafka, the producer built by
             hand — only when there is a broker to send to (KAFKA_BROKERS). -->
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
        </dependency>
        <!-- The demo's reset (process reset-demo): its own tables emptied, its listeners paused around it.
             Installed from ../../supporting/demo-reset first. Served as the engine's task reset@1 by a
             worker of its own (infra/demo/EngineWorker): no worker-kafka here — that one is Spring Cloud
             Stream and Boot 3. -->
        <dependency>
            <groupId>io.mateu.ecdemo1</groupId>
            <artifactId>demo-reset</artifactId>
            <version>0.1.0</version>
        </dependency>
        <!-- The outbox, its relay and the inbox, shared by the services. Installed from
             ../../supporting/messaging first. -->
        <dependency>
            <groupId>io.mateu.ecdemo1</groupId>
            <artifactId>messaging</artifactId>
            <version>0.1.0</version>
        </dependency>
        <!-- Read-only SQL over this service's agent views, for the AI agents (doc/src/content/docs/ia/datos-del-agente.md).
             Installed from ../../supporting/agent-sql first. -->
        <dependency>
            <groupId>io.mateu.ecdemo1</groupId>
            <artifactId>agent-sql</artifactId>
            <version>0.1.0</version>
        </dependency>
        <!-- The contracts this service speaks (contracts/, installed first): one library per context,
             only the contexts it talks to. -->
        <dependency>
            <groupId>io.mateu.ecdemo1</groupId>
            <artifactId>contracts-reservation</artifactId>
            <version>1.0.0</version>
        </dependency>
        <dependency>
            <groupId>io.mateu.ecdemo1</groupId>
            <artifactId>contracts-customer</artifactId>
            <version>1.0.0</version>
        </dependency>
        <!-- The reception notices (notices), as the notices service publishes them. -->
        <dependency>
            <groupId>io.mateu.ecdemo1</groupId>
            <artifactId>contracts-notices</artifactId>
            <version>1.0.0</version>
        </dependency>
        <!-- The registration rules (registration-rules), as the control plane publishes them, and how
             one reads: the same reading as the control plane's «Probar». -->
        <dependency>
            <groupId>io.mateu.ecdemo1</groupId>
            <artifactId>contracts-registration</artifactId>
            <version>1.0.0</version>
        </dependency>
        <dependency>
            <groupId>io.mateu.ecdemo1</groupId>
            <artifactId>contracts-frontoffice</artifactId>
            <version>1.0.0</version>
        </dependency>
        <dependency>
            <groupId>io.mateu.ecdemo1</groupId>
            <artifactId>contracts-audit</artifactId>
            <version>1.0.0</version>
        </dependency>
        <!-- The notices it asks the communication service to deliver (an incomplete check-in overdue). -->
        <dependency>
            <groupId>io.mateu.ecdemo1</groupId>
            <artifactId>contracts-communication</artifactId>
            <version>1.0.0</version>
        </dependency>
        <!-- Its messages checked against the topics' schemas (contracts/schemas). -->
        <dependency>
            <groupId>io.mateu.ecdemo1</groupId>
            <artifactId>contracts-testing</artifactId>
            <version>1.0.0</version>
            <scope>test</scope>
        </dependency>
        <!-- The demo's reset against the real schema (schema.sql on PostgreSQL): H2 truncates one table
             at a time and knows no to_regclass. The core module alone, its container started by hand. -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- The proforma invoice the desk opens when the PMS gave no document of its own. -->
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
            <version>3.0.3</version>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <!-- Traces, to the Tempo the engine exports to (Boot 4's OpenTelemetry starter: Micrometer's
             observations as OpenTelemetry spans, shipped over OTLP). Taking a stay from
             front-office-commands joins the trace of the booking that wrote it into Opera. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-opentelemetry</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                        <path>
                            <groupId>io.mateu</groupId>
                            <artifactId>annotation-processor-mvc</artifactId>
                            <version>${mateu.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
