{
  "title": "IA agents",
  "uid": "ia-agents",
  "tags": [
    "ia"
  ],
  "timezone": "",
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "type": "query",
        "name": "agent",
        "label": "Agent",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(ia_agent_prompt_seconds_count, gen_ai_agent_id)",
          "refId": "agent"
        },
        "definition": "label_values(ia_agent_prompt_seconds_count, gen_ai_agent_id)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      },
      {
        "type": "query",
        "name": "workflow",
        "label": "Workflow (LLM_CALL)",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(eventconductor_llm_call_seconds_count, workflow)",
          "refId": "workflow"
        },
        "definition": "label_values(eventconductor_llm_call_seconds_count, workflow)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      }
    ]
  },
  "links": [
    {
      "title": "IA token usage",
      "type": "link",
      "url": "/d/ia-tokens",
      "icon": "dashboard"
    }
  ],
  "panels": [
    {
      "type": "row",
      "title": "Prompts (ia_agent_prompt_seconds — one per prompt, span invoke_agent <agent>)",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "stat",
      "title": "Prompts in selected range",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(increase(ia_agent_prompt_seconds_count{gen_ai_agent_id=~\"$agent\"}[$__range]))",
          "legendFormat": "total",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Failed prompts in selected range",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(increase(ia_agent_prompt_seconds_count{gen_ai_agent_id=~\"$agent\",ia_outcome!=\"success\"}[$__range])) or vector(0)",
          "legendFormat": "total",
          "refId": "A"
        }
      ],
      "description": "refused (budget, disabled agent, no configuration), no_tools (no MCP server and no RAG source reachable) and error (an exception during the prompt)."
    },
    {
      "type": "timeseries",
      "title": "Prompts/sec by agent",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (gen_ai_agent_id) (rate(ia_agent_prompt_seconds_count{gen_ai_agent_id=~\"$agent\"}[5m]))",
          "legendFormat": "{{gen_ai_agent_id}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Failed prompts/sec by agent and outcome",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 2,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (gen_ai_agent_id, ia_outcome) (rate(ia_agent_prompt_seconds_count{gen_ai_agent_id=~\"$agent\",ia_outcome!=\"success\"}[5m]))",
          "legendFormat": "{{gen_ai_agent_id}} · {{ia_outcome}}",
          "refId": "A"
        }
      ],
      "description": "ia_outcome: refused | no_tools | error. \"unresolved\" is a prompt refused before the control plane named an agent."
    },
    {
      "type": "timeseries",
      "title": "Prompt latency p50 / p95 by agent",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le, gen_ai_agent_id) (rate(ia_agent_prompt_seconds_bucket{gen_ai_agent_id=~\"$agent\"}[5m])))",
          "legendFormat": "p50 {{gen_ai_agent_id}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, gen_ai_agent_id) (rate(ia_agent_prompt_seconds_bucket{gen_ai_agent_id=~\"$agent\"}[5m])))",
          "legendFormat": "p95 {{gen_ai_agent_id}}",
          "refId": "B"
        }
      ],
      "description": "The whole prompt: resolve, MCP connections, every model round trip and every tool call."
    },
    {
      "type": "row",
      "title": "Model (gen_ai_client_operation_seconds — one per round trip to the LLM)",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 17
      }
    },
    {
      "type": "timeseries",
      "title": "Model latency p50 / p95 by model",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le, gen_ai_request_model) (rate(gen_ai_client_operation_seconds_bucket{gen_ai_agent_id=~\"$agent\"}[5m])))",
          "legendFormat": "p50 {{gen_ai_request_model}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, gen_ai_request_model) (rate(gen_ai_client_operation_seconds_bucket{gen_ai_agent_id=~\"$agent\"}[5m])))",
          "legendFormat": "p95 {{gen_ai_request_model}}",
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Model calls/sec by model and error",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (gen_ai_request_model, gen_ai_system, error) (rate(gen_ai_client_operation_seconds_count{gen_ai_agent_id=~\"$agent\"}[5m]))",
          "legendFormat": "{{gen_ai_request_model}} ({{gen_ai_system}}) · {{error}}",
          "refId": "A"
        }
      ],
      "description": "error=\"none\" is a successful call; anything else is the exception class. A prompt with tool calls makes several model calls."
    },
    {
      "type": "row",
      "title": "Tools (spring_ai_tool_seconds — one per tool call, span execute_tool <tool>)",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 26
      }
    },
    {
      "type": "timeseries",
      "title": "Tool calls/sec by tool",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 27
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 2,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (spring_ai_tool_definition_name) (rate(spring_ai_tool_seconds_count{gen_ai_agent_id=~\"$agent\"}[5m]))",
          "legendFormat": "{{spring_ai_tool_definition_name}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Tool calls/sec by agent",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 27
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 2,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (gen_ai_agent_id) (rate(spring_ai_tool_seconds_count{gen_ai_agent_id=~\"$agent\"}[5m]))",
          "legendFormat": "{{gen_ai_agent_id}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Tool latency p50 / p95 by tool",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 35
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le, spring_ai_tool_definition_name) (rate(spring_ai_tool_seconds_bucket{gen_ai_agent_id=~\"$agent\"}[5m])))",
          "legendFormat": "p50 {{spring_ai_tool_definition_name}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, spring_ai_tool_definition_name) (rate(spring_ai_tool_seconds_bucket{gen_ai_agent_id=~\"$agent\"}[5m])))",
          "legendFormat": "p95 {{spring_ai_tool_definition_name}}",
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Tool errors/sec by tool",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 35
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 2,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (spring_ai_tool_definition_name, error) (rate(spring_ai_tool_seconds_count{gen_ai_agent_id=~\"$agent\",error!=\"none\"}[5m]))",
          "legendFormat": "{{spring_ai_tool_definition_name}} · {{error}}",
          "refId": "A"
        }
      ],
      "description": "A failed MCP call (server down, timeout, tool error) — answered to the model as an error text, and recorded here."
    },
    {
      "type": "table",
      "title": "Tool calls in selected range, by agent and tool",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 43
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "gen_ai_agent_id": "agent",
              "spring_ai_tool_definition_name": "tool",
              "Value": "calls"
            }
          }
        }
      ],
      "targets": [
        {
          "expr": "sum by (gen_ai_agent_id, spring_ai_tool_definition_name) (round(increase(spring_ai_tool_seconds_count{gen_ai_agent_id=~\"$agent\"}[$__range])))",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "title": "Data path (ia.data.path — how each prompt reached the data: search…, SQL over the agent views, both, other tools)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 51
      },
      "panels": []
    },
    {
      "type": "table",
      "title": "Prompts in selected range by data path: how many, and what each cost on average",
      "description": "search = a search… tool; sql = query…Data / describe…Data (agent-sql); search+sql = both; other = only other tools (e.g. one getStay per stay); none = no tool. doc/src/content/docs/ia/datos-del-agente.md",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 52
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "prompts"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "avg latency"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "failed"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true
      },
      "targets": [
        {
          "expr": "sum by (ia_data_path) (round(increase(ia_agent_prompt_seconds_count{gen_ai_agent_id=~\"$agent\"}[$__range])))",
          "format": "table",
          "instant": true,
          "refId": "A"
        },
        {
          "expr": "sum by (ia_data_path) (increase(ia_agent_prompt_tool_calls_sum{gen_ai_agent_id=~\"$agent\"}[$__range])) / sum by (ia_data_path) (increase(ia_agent_prompt_tool_calls_count{gen_ai_agent_id=~\"$agent\"}[$__range]))",
          "format": "table",
          "instant": true,
          "refId": "B"
        },
        {
          "expr": "sum by (ia_data_path) (increase(ia_agent_prompt_tokens_sum{gen_ai_agent_id=~\"$agent\"}[$__range])) / sum by (ia_data_path) (increase(ia_agent_prompt_tokens_count{gen_ai_agent_id=~\"$agent\"}[$__range]))",
          "format": "table",
          "instant": true,
          "refId": "C"
        },
        {
          "expr": "sum by (ia_data_path) (increase(ia_agent_prompt_seconds_sum{gen_ai_agent_id=~\"$agent\"}[$__range])) / sum by (ia_data_path) (increase(ia_agent_prompt_seconds_count{gen_ai_agent_id=~\"$agent\"}[$__range]))",
          "format": "table",
          "instant": true,
          "refId": "D"
        },
        {
          "expr": "sum by (ia_data_path) (increase(ia_agent_prompt_seconds_count{gen_ai_agent_id=~\"$agent\",ia_outcome!=\"success\"}[$__range])) / sum by (ia_data_path) (increase(ia_agent_prompt_seconds_count{gen_ai_agent_id=~\"$agent\"}[$__range]))",
          "format": "table",
          "instant": true,
          "refId": "E"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "ia_data_path": "data path",
              "Value #A": "prompts",
              "Value #B": "avg tool calls",
              "Value #C": "avg tokens",
              "Value #D": "avg latency",
              "Value #E": "failed"
            }
          }
        }
      ]
    },
    {
      "type": "row",
      "title": "Tokens",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 60
      }
    },
    {
      "type": "stat",
      "title": "Tokens in selected range",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 61
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(increase(ia_tokens_total{agent=~\"$agent\"}[$__range]))",
          "legendFormat": "total",
          "refId": "A"
        }
      ],
      "description": "ia_tokens_total, from the control plane: what the agent reported per prompt, the figure budgets are checked against."
    },
    {
      "type": "timeseries",
      "title": "Tokens/sec by agent and type (control plane)",
      "gridPos": {
        "h": 8,
        "w": 9,
        "x": 6,
        "y": 61
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 2,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (agent, type) (rate(ia_tokens_total{agent=~\"$agent\"}[5m]))",
          "legendFormat": "{{agent}} · {{type}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Tokens/sec by model and type (Spring AI)",
      "gridPos": {
        "h": 8,
        "w": 9,
        "x": 15,
        "y": 61
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 2,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (gen_ai_request_model, gen_ai_token_type) (rate(gen_ai_client_token_usage_total{gen_ai_agent_id=~\"$agent\",gen_ai_token_type!=\"total\"}[5m]))",
          "legendFormat": "{{gen_ai_request_model}} · {{gen_ai_token_type}}",
          "refId": "A"
        }
      ],
      "description": "gen_ai_client_token_usage_total, per model round trip, as the provider reported it. Its cost is in the Cost rows below."
    },
    {
      "type": "row",
      "title": "Cost — agents (ia_tokens_total × ia_llm_price_per_mtoken, the LLM catalogue's prices)",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 69
      }
    },
    {
      "type": "stat",
      "title": "Agent cost in selected range",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 70
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "expr": "sum by (currency) (increase(ia_tokens_total{agent=~\"$agent\"}[$__range]) * on (llm, type) group_left(currency) max by (llm, type, currency) (ia_llm_price_per_mtoken)) / 1e6",
          "legendFormat": "{{currency}}",
          "refId": "A",
          "instant": true
        }
      ],
      "description": "Tokens × the price per million the LLM catalogue sets for each model (control plane → LLMs → Pricing, exported as ia_llm_price_per_mtoken). A model with no price is left out, not counted as free; each currency is added up on its own."
    },
    {
      "type": "timeseries",
      "title": "Agent cost per hour by agent",
      "gridPos": {
        "h": 8,
        "w": 9,
        "x": 6,
        "y": 70
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 2,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (agent, currency) (increase(ia_tokens_total{agent=~\"$agent\"}[1h]) * on (llm, type) group_left(currency) max by (llm, type, currency) (ia_llm_price_per_mtoken)) / 1e6",
          "legendFormat": "{{agent}} · {{currency}}",
          "refId": "A"
        }
      ],
      "description": "Tokens × the price per million the LLM catalogue sets for each model (control plane → LLMs → Pricing, exported as ia_llm_price_per_mtoken). A model with no price is left out, not counted as free; each currency is added up on its own."
    },
    {
      "type": "table",
      "title": "Agent cost in selected range, by agent and LLM",
      "gridPos": {
        "h": 8,
        "w": 9,
        "x": 15,
        "y": 70
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 4
        },
        "overrides": []
      },
      "options": {
        "sortBy": [
          {
            "displayName": "Value",
            "desc": true
          }
        ]
      },
      "targets": [
        {
          "expr": "sum by (agent, llm, currency) (increase(ia_tokens_total{agent=~\"$agent\"}[$__range]) * on (llm, type) group_left(currency) max by (llm, type, currency) (ia_llm_price_per_mtoken)) / 1e6",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value": "cost"
            }
          }
        }
      ],
      "description": "Tokens × the price per million the LLM catalogue sets for each model (control plane → LLMs → Pricing, exported as ia_llm_price_per_mtoken). A model with no price is left out, not counted as free; each currency is added up on its own."
    },
    {
      "type": "row",
      "title": "Workflows — LLM_CALL steps (eventconductor_llm_call_seconds, eventconductor_llm_tokens_total)",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 78
      }
    },
    {
      "type": "timeseries",
      "title": "LLM calls/sec by workflow and step",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 79
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 2,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (workflow, step) (rate(eventconductor_llm_call_seconds_count{workflow=~\"$workflow\"}[5m]))",
          "legendFormat": "{{workflow}} · {{step}}",
          "refId": "A"
        }
      ],
      "description": "One per LLM_CALL step execution in the EventConductor engine — the model called directly by a workflow, not through an agent."
    },
    {
      "type": "timeseries",
      "title": "LLM call latency p50 / p95 by model",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 79
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 2,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le, model) (rate(eventconductor_llm_call_seconds_bucket{workflow=~\"$workflow\"}[5m])))",
          "legendFormat": "p50 · {{model}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, model) (rate(eventconductor_llm_call_seconds_bucket{workflow=~\"$workflow\"}[5m])))",
          "legendFormat": "p95 · {{model}}",
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "LLM calls/sec that did not succeed, by step and outcome",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 79
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 2,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (workflow, step, outcome) (rate(eventconductor_llm_call_seconds_count{workflow=~\"$workflow\",outcome!=\"success\"}[5m]))",
          "legendFormat": "{{workflow}} · {{step}} · {{outcome}}",
          "refId": "A"
        }
      ],
      "description": "error = the provider failed or timed out; invalid_output = the answer did not match the step's responseSchema."
    },
    {
      "type": "timeseries",
      "title": "LLM tokens/sec by workflow and type",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 87
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 2,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (workflow, type) (rate(eventconductor_llm_tokens_total{workflow=~\"$workflow\"}[5m]))",
          "legendFormat": "{{workflow}} · {{type}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Workflow LLM cost in selected range",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 8,
        "y": 87
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "expr": "sum by (currency) (increase(eventconductor_llm_tokens_total{workflow=~\"$workflow\"}[$__range]) * on (model, type) group_left(currency) max by (model, type, currency) (ia_llm_price_per_mtoken)) / 1e6",
          "legendFormat": "{{currency}}",
          "refId": "A",
          "instant": true
        }
      ],
      "description": "Tokens × the price the LLM catalogue sets for the same provider model id (joined on model). A model no catalogue entry prices is left out."
    },
    {
      "type": "table",
      "title": "Workflow LLM cost and calls in selected range, by workflow and step",
      "gridPos": {
        "h": 8,
        "w": 10,
        "x": 14,
        "y": 87
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 4
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (workflow, step, model, currency) (increase(eventconductor_llm_tokens_total{workflow=~\"$workflow\"}[$__range]) * on (model, type) group_left(currency) max by (model, type, currency) (ia_llm_price_per_mtoken)) / 1e6",
          "format": "table",
          "instant": true,
          "refId": "A"
        },
        {
          "expr": "sum by (workflow, step, model) (increase(eventconductor_llm_call_seconds_count{workflow=~\"$workflow\"}[$__range]))",
          "format": "table",
          "instant": true,
          "refId": "B"
