<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.4</version>
        <relativePath/>
    </parent>

    <groupId>io.mateu.ecdemo1</groupId>
    <artifactId>users</artifactId>
    <version>0.1.0</version>
    <name>ec-demo1 users</name>
    <description>Users, groups, roles and permissions: a Mateu CRUD at /_users, plus the gRPC contract that serves a user's roles and scopes</description>

    <properties>
        <java.version>21</java.version>
        <!-- Pinned rather than floating, like the shell's. -->
        <mateu.version>3.0-alpha.421</mateu.version>
        <!-- Only for `shared`, the engine's DTO jar: this service uses its AggregateRoot base
             class. It tracks the engine image tag in deploy/values/eventconductor.yaml. -->
        <eventconductor.version>2.23.1</eventconductor.version>
        <spring-grpc.version>1.0.0</spring-grpc.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.grpc</groupId>
                <artifactId>spring-grpc-dependencies</artifactId>
                <version>${spring-grpc.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- No Kafka binder, deliberately — the same removal as in `content`, and for the same
             reason: the version this was ported from declared three bindings and implemented
             none of them, under the engine's own consumer group names. -->

        <dependency>
            <groupId>io.mateu.workflow</groupId>
            <artifactId>shared</artifactId>
            <version>${eventconductor.version}</version>
        </dependency>

        <dependency>
            <groupId>io.mateu</groupId>
            <artifactId>mvc-core</artifactId>
            <version>${mateu.version}</version>
        </dependency>
        <!-- What the UIs share: paging, the signed-in user, link tables, the catalogue CRUD base. -->
        <dependency>
            <groupId>io.mateu.ecdemo1</groupId>
            <artifactId>ui-commons</artifactId>
            <version>0.1.0</version>
        </dependency>
        <dependency>
            <groupId>io.mateu</groupId>
            <artifactId>vaadin-lit</artifactId>
            <version>${mateu.version}</version>
        </dependency>
        <dependency>
            <groupId>io.mateu</groupId>
            <artifactId>annotation-processor-mvc</artifactId>
            <version>${mateu.version}</version>
        </dependency>

        <!-- The gRPC side: AuthService answers GetAuthInfo with a user's roles and scopes. The
             stubs come from ../grpc-interface, which has to be installed first — see
             deploy/build-images.sh, which builds it before this module. -->
        <dependency>
            <groupId>io.mateu.ecdemo1</groupId>
            <artifactId>grpc-interface</artifactId>
            <version>0.1.0</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.grpc</groupId>
            <artifactId>spring-grpc-spring-boot-starter</artifactId>
        </dependency>

        <!-- Health probes and the Prometheus endpoint the pod annotation points Prometheus at.
             Without the registry, /actuator/prometheus does not exist even with actuator on the
             classpath, and the scrape silently returns 404 forever. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- The outbox and its relay, shared by the services: here it delivers the identity changes
             to Keycloak (IdentityTransport). Installed from ../../supporting/messaging first. -->
        <dependency>
            <groupId>io.mateu.ecdemo1</groupId>
            <artifactId>messaging</artifactId>
            <version>0.1.0</version>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </path>
                        <path>
                            <groupId>io.mateu</groupId>
                            <artifactId>annotation-processor-mvc</artifactId>
                            <version>${mateu.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
