<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Boot 3.4.3 rather than the shell's Boot 4: Spring AI 1.0.0, which is what serves the MCP
         tools this service exposes to the agent, is built against Boot 3.4 and does not start on
         4. These are separate processes and do not have to match — the gateway already runs 3.4.1
         next to a Boot 4 shell. -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.3</version>
        <relativePath/>
    </parent>

    <groupId>io.mateu.ecdemo1</groupId>
    <artifactId>communication-service</artifactId>
    <version>0.1.0</version>
    <name>ec-demo1 communication-service</name>
    <description>Sends the notifications the integration asks for: resolves who gets each kind, for which hotel; delivers by e-mail through the SMTP relay; keeps the history</description>

    <properties>
        <java.version>21</java.version>
        <!-- Pinned, like the shell's: the versions this deployment was built and verified
             against. `shared` is the engine's own DTO jar and tracks the engine image tag in
             deploy/values/eventconductor.yaml — the events on the wire are defined there, so a
             mismatch is a deserialization failure at runtime and not a compile error. -->
        <mateu.version>3.0-alpha.415</mateu.version>
        <eventconductor.version>2.23.1</eventconductor.version>
        <spring-cloud.version>2024.0.0</spring-cloud.version>
        <spring-ai.version>1.0.0</spring-ai.version>
        <!-- Ahead of what Boot 3.4.3 manages (1.18.36), which does not run on a JDK 25 javac and
             fails the build with "TypeTag :: UNKNOWN" rather than anything that names Lombok.
             1.18.44 is what the Boot 4 modules here already resolve to. -->
        <lombok.version>1.18.44</lombok.version>
        <!-- Ahead of what Boot 3.4.3 manages (1.20.x), whose docker-java speaks an API version
             Docker 29 no longer accepts. 1.21.4 is what the engine's own container tests use. -->
        <testcontainers.version>1.21.4</testcontainers.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>
        <!-- The OpenAPI document at /v3/api-docs. gitops' booking-api entry offers this service's REST
             API to agents from that document, which did not exist until the service had a REST API. -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-api</artifactId>
            <version>2.8.6</version>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- The worker side of the saga: it consumes the `booking` topic and answers on
             `upstream`. Both bindings are Spring Cloud Stream, so the Kafka binder is not
             optional here the way it is for the content and users services. -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-stream-kafka</artifactId>
        </dependency>

        <!-- The contracts this service speaks (contracts/, installed first): one library per context,
             only the contexts it talks to. -->
        <dependency>
            <groupId>io.mateu.ecdemo1</groupId>
            <artifactId>contracts-communication</artifactId>
            <version>1.0.0</version>
        </dependency>
        <!-- human-tasks is the forms engine's topic: its schema is generated from the engine's own
             record (HumanTaskChanged), the jar alone. -->
        <dependency>
            <groupId>io.mateu.workflow</groupId>
            <artifactId>shared</artifactId>
            <version>${eventconductor.version}</version>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- Its messages checked against the topics' schemas (contracts/schemas). -->
        <dependency>
            <groupId>io.mateu.ecdemo1</groupId>
            <artifactId>contracts-testing</artifactId>
            <version>1.0.0</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.mateu.workflow</groupId>
            <artifactId>shared</artifactId>
            <version>${eventconductor.version}</version>
        </dependency>
        <!-- The demo's reset (process reset-demo): the engine's task reset@1 on the topic communication —
             the worker runtime (worker-kafka) and the reset every service does to itself (demo-reset). -->
        <dependency>
            <groupId>io.mateu.workflow</groupId>
            <artifactId>worker-kafka</artifactId>
            <version>${eventconductor.version}</version>
        </dependency>
        <dependency>
            <groupId>io.mateu.ecdemo1</groupId>
            <artifactId>demo-reset</artifactId>
            <version>0.1.0</version>
        </dependency>

        <dependency>
            <groupId>io.mateu</groupId>
            <artifactId>mvc-core</artifactId>
            <version>${mateu.version}</version>
        </dependency>
        <!-- What the UIs share: paging, the signed-in user, link tables, the catalogue CRUD base. -->
        <dependency>
            <groupId>io.mateu.ecdemo1</groupId>
            <artifactId>ui-commons</artifactId>
            <version>0.1.0</version>
        </dependency>
        <dependency>
            <groupId>io.mateu</groupId>
            <artifactId>vaadin-lit</artifactId>
            <version>${mateu.version}</version>
        </dependency>
        <dependency>
            <groupId>io.mateu</groupId>
            <artifactId>annotation-processor-mvc</artifactId>
            <version>${mateu.version}</version>
        </dependency>

        <!-- MCP server: the tools ia-agent calls to create, list and change bookings. -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-mcp-server-webmvc</artifactId>
            <version>${spring-ai.version}</version>
        </dependency>

        <!-- Health probes and the Prometheus endpoint the pod annotation points Prometheus at.
             Without the registry, /actuator/prometheus does not exist even with actuator on the
             classpath, and the scrape silently returns 404 forever. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <!-- Traces, to the Tempo the engine exports to: the bridge makes Micrometer's observations
             OpenTelemetry spans, the exporter ships them over OTLP (management.otlp.tracing.*). -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing-bridge-otel</artifactId>
        </dependency>
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-exporter-otlp</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- An SMTP server in the test JVM, to see what would have been sent. -->
        <dependency>
            <groupId>com.icegreen</groupId>
            <artifactId>greenmail-junit5</artifactId>
            <version>2.1.3</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>redpanda</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </path>
                        <path>
                            <groupId>io.mateu</groupId>
                            <artifactId>annotation-processor-mvc</artifactId>
                            <version>${mateu.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
